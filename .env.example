# Default/local profile (.env)
# Enables the simulated Valle Lumina GPS path during local development.
VITE_DEMO_LOCATION=true

# Public base path used by Vite in production builds (GitHub Pages repo path).
VITE_BASE_PATH=/BusinessNavigation/

# Default business route used when opening the app root URL.
VITE_DEFAULT_BUSINESS_ID=parque-saavedra

# GitHub Pages profile (.env.pages)
# Use with: npm run build:pages
# VITE_DEMO_LOCATION=false
# VITE_BASE_PATH=/BusinessNavigation/
# VITE_DEFAULT_BUSINESS_ID=parque-saavedra